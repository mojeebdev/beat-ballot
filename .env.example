# Public site
NEXT_PUBLIC_APP_URL=https://beatballot.space

# Neon Postgres connection string from the Neon Console. Never expose this value.
DATABASE_URL=

# Neon Managed Better Auth endpoint for this database branch.
NEON_AUTH_BASE_URL=

# Required by @neondatabase/auth to sign cached session data. Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep the same value across each deployment environment; never commit it.
NEON_AUTH_COOKIE_SECRET=
